# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code (skills, local settings — non nécessaires au déploiement)
.claude/

# captures d'écran déposées à la racine (ex. partages WhatsApp)
/WhatsApp Image*

# fichiers de référence et images déposées à la racine (maquettes, palettes…)
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.avif
/*.gif

# fichiers HTML de référence déposés à la racine
/*.html
/*_files/

# données invités — ne jamais versionner (données personnelles)
/*.csv

# fichiers parasites (installeurs, dossiers temporaires de navigateur)
*.exe
/scoped_dir*/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
